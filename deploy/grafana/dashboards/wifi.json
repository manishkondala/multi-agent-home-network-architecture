{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Smoothed RTT (kernel TCP_INFO) for each connected device. The browser can't see this — it's read on the Pi from the server side of the connection.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_health_srtt_ms", "legendFormat": "{{client}}", "refId": "A" }
      ],
      "title": "Live SRTT per device (kernel TCP_INFO)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "TX congestion window (segments) per device. Low/sawtooth cwnd under load points at a lossy link.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_health_snd_cwnd_segments", "legendFormat": "{{client}}", "refId": "A" }
      ],
      "title": "TX congestion window per device",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Kernel-measured delivery rate (goodput) per device.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "Mbits" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_health_delivery_rate_mbps", "legendFormat": "{{client}}", "refId": "A" }
      ],
      "title": "Delivery rate per device",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative TCP retransmissions on each device's socket. Climbing = a lossy radio link.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_health_retrans", "legendFormat": "{{client}}", "refId": "A" }
      ],
      "title": "Retransmits per device",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latest health-check throughput by room/device (from completed user checks).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "Mbits" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "legend": { "showLegend": true } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_health_session_download_mbps", "legendFormat": "{{room}} / {{device}} ↓", "instant": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_health_session_upload_mbps", "legendFormat": "{{room}} / {{device}} ↑", "instant": true, "refId": "B" }
      ],
      "title": "Last check: throughput by room",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latest health-check average RTT by room/device.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "always" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_health_session_rtt_ms", "legendFormat": "{{room}} / {{device}}", "refId": "A" }
      ],
      "title": "Session RTT by room",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Neighbouring APs seen on each channel (co-channel congestion). More APs / higher signal on your channel = slower link even when your own signal is fine.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "options": { "orientation": "auto", "showValue": "auto", "stacking": "none", "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_rf_channel_ap_count", "legendFormat": "ch {{channel}} ({{band}})", "instant": true, "refId": "A" }
      ],
      "title": "RF: neighbour APs per channel",
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Visible neighbour APs by band over time. (Channel noise floor / non-Wi-Fi interference like a microwave needs a survey-capable radio — onboard Broadcom doesn't expose it; see ROADMAP v0.5 P2.)",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "wifi_rf_neighbor_aps", "legendFormat": "{{band}}", "refId": "A" }
      ],
      "title": "RF: neighbour APs by band",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pi-fleet", "wifi"],
